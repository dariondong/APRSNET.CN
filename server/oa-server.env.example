# APRSNETCN OA 后端。复制成 oa-server.env 改一改，这个文件本身别提交。
# 数据目录：oa.db 与日志放这里
OA_DATA_DIR=/var/lib/oa-server
# 监听：填 0.0.0.0 才给外面看，只在本机调试就留 127.0.0.1
OA_HOST=127.0.0.1
OA_PORT=8090
# 站点根目录：后端从这里读 oa/index.html、oa/data.html、style.css、assets
OA_SITE_ROOT=/srv/APRSNET.CN
# 主控台口令，必填
OA_ADMIN_TOKEN=
# APRS-IS：只收，pass 用 -1
OA_APRS_HOST=rotate.aprs2.net
OA_APRS_PORT=14580
OA_APRS_LOGIN=BG7LZQ-2
# 过滤：中国上空的位置报文，加上发给轮值呼号的报文（g/ 那段照当轮主控呼号走）
OA_APRS_FILTER=a/54/73/18/135 g/BG7LZQ-2
# 收到的新报文并进哪一轮的呼号
OA_ROUND_DUTY=BG7LZQ-2
# 发 ACK 用的报文口令。空着就是只记不发
OA_TX_PASSCODE=
# 有人喊到就自动回一条 ACK：1 开，0 关（没口令时不生效）。全自动开着时也认这一行
OA_AUTO_ACK=1
# 全自动：开轮收轮、回 ACK、补漏都不用人守。主控台上能当场开关，这一行是默认值
OA_AUTO=1
# 没回成的 ACK 过一分钟自己补，一台一轮最多补几次（0 不补）
OA_ACK_RETRY=3
# 回过去的那句话
OA_ACK_TEXT=ACK
# 签到那行没写出网格时回的那句话
OA_BAD_TEXT=INVALID CHECKIN, RESEND: CQ CNNET <info> <GRID>
# 发给轮值呼号、又不是签到那两步时回的那句话
OA_HELP_TEXT=APRSNETCN OA: CQ CNNET <INFO> <GRID>, THEN U CNNET
# 一分钟最多发几条
OA_ACK_MAX_PER_MINUTE=12
# 名单顺手写一份到这里（给静态站用），空着不写
OA_PUBLISH_ROSTER=
# 一到周六（北京时间）就自己开当天的轮，周六过完自己收轮：1 开，0 关。全自动开着时也认这一行
OA_AUTO_ROUND=1
# 收轮归档写到哪，空着就是数据目录下的 archive/
OA_ARCHIVE_DIR=
# 区域里的闲聊报文最多留多少条
OA_KEEP_OTHER=20000
